generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model medicine_categories {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String                        @unique @db.VarChar(50)
  sort_order                  Int                           @default(0)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  medicine_category_relations medicine_category_relations[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model medicine_category_relations {
  medicine_item_id    String              @db.Uuid
  category_id         String              @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  medicine_categories medicine_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medicine_category_category")
  medicine_items      medicine_items      @relation(fields: [medicine_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medicine_category_medicine")

  @@id([medicine_item_id, category_id])
  @@index([category_id], map: "idx_medicine_category_relations_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model medicine_items {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     String                        @db.Uuid
  name                        String                        @db.VarChar(100)
  specification               String?                       @db.VarChar(100)
  dosage_form                 String?                       @db.VarChar(50)
  quantity                    Int                           @default(1)
  unit                        medicine_unit
  expiration_date             DateTime?                     @db.Date
  manufacturer                String?                       @db.VarChar(150)
  efficacy                    String?
  dose_per_time               Decimal?                      @db.Decimal(6, 2)
  times_per_day               Int?                          @db.SmallInt
  medication_timing           medication_timing?
  location                    String?                       @db.VarChar(100)
  image_url                   String?
  note                        String?
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  medicine_category_relations medicine_category_relations[]

  @@index([expiration_date], map: "idx_medicine_items_expiration_date")
  @@index([name], map: "idx_medicine_items_name")
  @@index([user_id], map: "idx_medicine_items_user_id")
  @@index([user_id, name], map: "idx_medicine_items_user_name")
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum medicine_unit {
  GRAIN
  BAG
  BOTTLE
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum medication_timing {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  ON_WAKING
  BEFORE_SLEEP
  ANY_TIME
}
