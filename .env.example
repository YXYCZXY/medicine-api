PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/medicine
# 仅迁移旧单账号时使用；新安装无需填写，迁移后可删除。
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
# LOGIN_ACCOUNT=your-account
# LOGIN_PASSWORD=your-password-of-at-least-8-characters
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# 可选：真实数据库集成测试，必须显式指定名称以 _test 结尾的独立测试库。
# REMINDERS_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/medicine_test
